# All optional. With none of these set, the platform runs in mock mode.
LLM_PROVIDER=mock            # mock | ollama | anthropic | openrouter  (a provider NAME, never a key)
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=          # free tier works; see README
GITHUB_TOKEN=
OLLAMA_BASE_URL=http://localhost:11434

# Opt-in API authentication. Unset = open (local demo). Comma-separated entries:
#   label:key                 plaintext key (label names the recruiter or client)
#   label:sha256:<hex>        store a SHA-256 hash instead (echo -n KEY | shasum -a 256)
SCREENING_API_KEYS=
# example (placeholders only): SCREENING_API_KEYS=alice:replace-with-a-long-random-key,bob:sha256:<64-hex-chars>
# Browser origins allowed by CORS, comma-separated. Default: http://localhost:5173,http://localhost:8077,http://127.0.0.1:8077
SCREENING_CORS_ORIGINS=
